# Supabase — copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API.

# Your project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (recommended). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback — only needed if your project still uses the anon key
# instead of a publishable key. Leave blank if using the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Only needed for admin
# operations that must bypass RLS. Leave unset for basic email/password auth.
# SUPABASE_SERVICE_ROLE_KEY=
