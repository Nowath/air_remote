# Copy this file to `.env.local` and fill in the values.
# Nothing here is exposed to the browser — the app holds no client-side
# credentials, so none of these may carry a NEXT_PUBLIC_ prefix.

# --- PIN gate -----------------------------------------------------------
# The code visitors type to enter the app.
APP_PIN=

# Key used to sign the unlock cookie. Generate with `openssl rand -hex 32`.
# Rotating it (or changing APP_PIN) invalidates every issued cookie.
APP_SESSION_SECRET=

# --- Supabase ------------------------------------------------------------
# From Supabase Dashboard → Project Settings → API.

# Your project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# (NEXT_PUBLIC_SUPABASE_URL is still read as a fallback for older setups.)
SUPABASE_URL=

# Secret / service-role key. BYPASSES RLS — server-only, never NEXT_PUBLIC_.
# Dashboard → Project Settings → API keys → "secret" (legacy: service_role).
# Every Server Action checks the PIN cookie before touching this client.
SUPABASE_SECRET_KEY=
